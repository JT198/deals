[Unit]
Description=Deal finder morning digest (Telegram)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/deals
EnvironmentFile=/opt/deals/.env
ExecStart=/opt/deals/venv/bin/python -m app.digest
StandardOutput=append:/var/log/deals-scan.log
StandardError=append:/var/log/deals-scan.log
