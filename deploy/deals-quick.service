[Unit]
Description=Deal finder fast lane (quick searches, newest first)
After=network-online.target

[Service]
User=deals
Group=deals
Environment=HOME=/opt/deals/data/home PLAYWRIGHT_BROWSERS_PATH=/opt/deals/pw-browsers
# a manual run as root can leave root-owned database files behind; hand them back first ("+" = as root)
ExecStartPre=+/bin/sh -c 'chown deals:deals /opt/deals/data /opt/deals/data/deals.db* 2>/dev/null; true'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/deals/data
Type=oneshot
WorkingDirectory=/opt/deals
EnvironmentFile=/opt/deals/.env
ExecStart=/opt/deals/venv/bin/python -m app.scan --quick
TimeoutStartSec=15min
MemoryMax=1400M
OOMPolicy=kill
PrivateTmp=yes
Nice=5
StandardOutput=append:/var/log/deals-scan.log
StandardError=append:/var/log/deals-scan.log
