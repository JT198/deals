[Unit]
Description=Deal finder fast lane (quick searches, newest first)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/deals
EnvironmentFile=/opt/deals/.env
ExecStart=/opt/deals/venv/bin/python -m app.scan --quick
TimeoutStartSec=10min
Nice=5
StandardOutput=append:/var/log/deals-scan.log
StandardError=append:/var/log/deals-scan.log
