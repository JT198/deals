[Unit]
Description=UTV deal finder scan (Craigslist + Facebook Marketplace)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/deals
EnvironmentFile=/opt/deals/.env
ExecStart=/opt/deals/venv/bin/python -m app.scan
TimeoutStartSec=50min
MemoryMax=1400M
OOMPolicy=kill
PrivateTmp=yes
Nice=5
StandardOutput=append:/var/log/deals-scan.log
StandardError=append:/var/log/deals-scan.log
