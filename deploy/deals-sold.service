[Unit]
Description=Deal finder sold pull (Facebook Sold filter on every search)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/deals
EnvironmentFile=/opt/deals/.env
ExecStart=/opt/deals/venv/bin/python -m app.scan --sold --force
TimeoutStartSec=90min
MemoryMax=1400M
OOMPolicy=kill
PrivateTmp=yes
Nice=10
StandardOutput=append:/var/log/deals-scan.log
StandardError=append:/var/log/deals-scan.log
